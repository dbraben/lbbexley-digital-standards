{
  "description": "Bexley guardrails: session context and pre-election warnings, a personal-data guard on prompts, guards for Dataverse, Power Automate and pac that keep the assistant to the dev environment, a guard that stops pushes that could overwrite or delete work on GitHub, the standards check on every saved file, a note of every change to the dev environment, and the end-of-run gate, which brings the latest version into the repository, has the work reviewed on a smaller model, then committed and pushed.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/prompt-guard.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.*dataverse.*__",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/dataverse-guard.js"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*flowagent.*__",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/flow-guard.js"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/command-guard.js"
            ],
            "timeout": 70
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/check-file.js"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^mcp__.*(canvas-authoring|flowagent|dataverse).*__|^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/environment-change.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/stop-gate.js"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "end-of-run-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/end-of-run-record.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/end-of-run-record.js"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
